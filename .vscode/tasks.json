{
  "version": "2.0.0",
  "options": { "shell": { "executable": "cmd.exe", "args": ["/d", "/c"] } },
  "tasks": [
    { "label": "build", "type": "shell", "command": ".\\build.cmd", "group": { "kind": "build", "isDefault": true }, "problemMatcher": "$msCompile" },
    { "label": "build debug", "type": "shell", "command": ".\\build.cmd debug", "problemMatcher": "$msCompile" },
    { "label": "run", "type": "shell", "command": ".\\build.cmd run", "problemMatcher": "$msCompile" },
    { "label": "clean", "type": "shell", "command": ".\\build.cmd clean", "problemMatcher": [] },
    { "label": "rebuild", "type": "shell", "command": ".\\build.cmd clean release", "problemMatcher": "$msCompile" }
  ]
}
